# Server Environment Variables
PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/gethired?retryWrites=true&w=majority
JWT_SECRET=your_production_jwt_secret_key_here_min_32_chars
NODE_ENV=development

# Google Gemini AI Integration (Required for AI Resume Matching, ATS Optimization, Mock Interviews & Career Coach)
GEMINI_API_KEY=your_gemini_api_key_here

# Multi-Provider Job Search Aggregator Keys (Optional / Fallback provided)
JSEARCH_API_KEY=your_rapidapi_jsearch_key
JSEARCH_API_HOST=jsearch.p.rapidapi.com
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
JOOBLE_API_KEY=your_jooble_api_key
